# Copy to apps/server/.env and fill from the DEV Supabase project (Settings -> API).
# .env and .env.* are gitignored. Never commit a filled copy.

SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Reference tables and the session table only. Never user data — ADR 0007.
SUPABASE_SERVICE_KEY=

# Any long random string: `openssl rand -hex 32`
SESSION_COOKIE_SECRET=

# Not needed yet; listed so the shape is visible.
# FFIQ_API_KEY=
# POSTHOG_KEY=

# ANTHROPIC_API_KEY is deliberately absent and must NOT be created locally.
# Local and eval runs authenticate through the Claude Code session via the Agent
# SDK. A local key would draw down the £50 prepaid balance that is F7-AC-12's
# entire protection. See CLAUDE.md and ADR 0009.
